rules_version = '2';

// Each account's clinic data lives under users/{uid}/ and only that signed-in user
// may read or write it. Everything else is closed.
// Deploy with: npx firebase-tools deploy --only firestore:rules --project <your-project-id>
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
